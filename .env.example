# Sao chép thành .env (hoặc điền trong tab Environment Variables của Coolify).

# Domain bạn gán cho Admin UI trong Coolify (KHÔNG kèm https://).
# Dùng cho CSRF trusted origins của gophish.
ADMIN_DOMAIN=gophish.example.com

# Email liên hệ hiển thị trên landing page phishing (tùy chọn).
CONTACT_ADDRESS=

# Mật khẩu MySQL (đặt chuỗi mạnh, ngẫu nhiên).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-gophish
